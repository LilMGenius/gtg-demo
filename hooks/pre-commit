#!/bin/sh
# 빠른 게이트는 5초다. 커밋마다 돌려도 부담이 없고, 방금 고친 것이 다른 축을 깼는지 즉시 말한다.
# 막지는 않는다. 한 문제가 풀리면 나머지가 빨간 상태여도 커밋한다는 규칙이 더 위다.
node tools/run-gates.mjs fast || echo "  (fast gates are red; commit continues)"

# 직전 커밋이 띄운 느린 쓸기의 결과를 여기서 읽는다. 11분짜리를 커밋 앞에 세울 수는 없고,
# 읽지 않으면 그 쓸기는 아무에게도 도달하지 않는다.
#
# 마지막 줄을 그대로 찍으면 아직 도는 쓸기에서는 머리글이 나온다. 실측으로 여러 커밋이
# "slow: 71 of 92 gates"만 보고 지나갔고, 그동안 빨간 게이트 일곱이 아무에게도 안 닿았다.
# 판정 줄만 골라 찍고, 판정이 아직 없으면 없다고 말한다.
if [ -f sweep.local.txt ]; then
  verdict=$(grep "^gates " sweep.local.txt | tail -1)
  if [ -n "$verdict" ]; then
    echo "  last slow sweep: $verdict"
  elif [ "$(node tools/run-gates.mjs lockstate | cut -d' ' -f1)" = "running" ]; then
    echo "  last slow sweep: still running, no verdict yet"
  else
    echo "  last slow sweep: died without a verdict"
  fi
fi
exit 0
