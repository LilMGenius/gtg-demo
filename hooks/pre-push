#!/bin/sh
# 룩을 바꾸는 푸시는 룩 계약 게이트(tools/look-gate.mjs)가 초록일 때만 나간다.
# 룩은 파운더가 승인한 정체성이라 브랜드 결정이다. 빨간 룩 게이트는 게이트를 다시 읽을 일이 아니라 제품이 룩을 잃은 것이다.
# 느린 쓸기는 커밋 뒤에 따로 돌아서 거기서 빨개지면 이미 라이브에 나간 뒤다. 그래서 푸시 자리에서 막는다.
z40=0000000000000000000000000000000000000000
look='^(web/src/render/|web/assets/|web/src/state/gear\.mjs$|web/src/ui/[^/]*\.css$)'
touched=0
while read local_ref local_sha remote_ref remote_sha; do
  remote_sha=$(printf '%s' "$remote_sha" | tr -d '\r')
  [ "$local_sha" = "$z40" ] && continue
  if [ "$remote_sha" = "$z40" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes)
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi
  for c in $commits; do
    if git diff-tree --no-commit-id --name-only -r "$c" | grep -Eq "$look"; then touched=1; fi
  done
done
[ "$touched" = 0 ] && exit 0
if [ -n "$(git status --porcelain -- web/src/render web/assets web/src/state/gear.mjs web/src/ui)" ]; then
  echo "pre-push: the pushed commits change the look, and the working tree holds uncommitted look edits, so the gate would measure other bytes. Commit or stash them first."
  exit 1
fi
if ! node tools/look-gate.mjs; then
  echo "pre-push: the look gate is red, so the approved look changed. Restore it; changing the contract needs a founder ruling cited in the commit body. The gate reads the static server at 127.0.0.1:10310."
  exit 1
fi
exit 0
